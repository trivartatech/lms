generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role: ADMIN | SALES_MANAGER | SALES_EXECUTIVE
// PipelineStage: NEW | QUALIFIED | DEMO | PROPOSAL | NEGOTIATION | CLOSED_WON | CLOSED_LOST
// LeadStatus: NEW | IN_PROGRESS | CONVERTED | LOST
// TaskType: CALL | MEETING | REMINDER
// TaskStatus: PENDING | COMPLETED | CANCELLED
// QuotationStatus: DRAFT | SENT | ACCEPTED | REJECTED
// AgreementStatus: ACTIVE | EXPIRED | PENDING_RENEWAL
// BonusType: FIXED | PERCENTAGE
// PayoutStatus: PENDING | PAID

model User {
  renewals RenewalCase[]
  salesTargets SalesTarget[]
  inboxReads InboxRead[]
  assignedWork SchoolWork[]
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("SALES_EXECUTIVE")
  // Expo push token for mobile notifications (nullable)
  pushToken    String?  @map("push_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedLeads   Lead[]   @relation("AssignedLeads")
  assignedSchools School[] @relation("AssignedSchools")
  tasks           Task[]
  timelineEvents  TimelineEvent[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  // Hashed token (sha256) — never store raw
  tokenHash  String   @unique @map("token_hash")
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  // When rotated, replaced by the newly issued token id (chain for audit)
  replacedById Int?     @map("replaced_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Lead {
  id            Int      @id @default(autoincrement())
  schoolName    String   @map("school_name")
  contactPerson String   @map("contact_person")
  phone         String
  email         String?
  location      String?
  status        String   @default("NEW")
  pipelineStage String   @default("NEW") @map("pipeline_stage")
  notes         String?

  assignedToId Int?  @map("assigned_to")
  assignedTo   User? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  referredBySchoolId Int?    @map("referred_by_school_id")
  referredBySchool   School? @relation("ReferredLeads", fields: [referredBySchoolId], references: [id])
  referralNotes      String? @map("referral_notes")

  referredByLeadId Int?  @map("referred_by_lead_id")
  referredByLead   Lead? @relation("LeadReferrals", fields: [referredByLeadId], references: [id])
  referredLeads    Lead[] @relation("LeadReferrals")

  totalStudents Int? @map("total_students")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations        Quotation[]
  tasks             Task[]
  timelineEvents    TimelineEvent[]
  referralIncentive ReferralIncentive?
  convertedSchool   School?            @relation("ConvertedFromLead")
  addons            SchoolAddon[]
  contacts          Contact[]

  @@index([assignedToId])
  @@index([pipelineStage])
  @@index([status])
  @@index([referredBySchoolId])
  @@index([createdAt])
  @@map("leads")
}

model Contact {
  portalAccess SchoolPortalAccess?
  id          Int     @id @default(autoincrement())
  name        String
  phone       String
  email       String?
  designation String?
  isPrimary   Boolean @default(false) @map("is_primary")

  schoolId Int?    @map("school_id")
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  leadId Int?  @map("lead_id")
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([leadId])
  @@map("contacts")
}

model School {
  portalQuotes PortalQuote[]
  portalDocuments PortalDocument[]
  orders SchoolOrder[]
  territoryLink TerritorySchool?
  work SchoolWork[]
  files SchoolFile[]
  id            Int     @id @default(autoincrement())
  name          String
  contactPerson String  @map("contact_person")
  phone         String
  email         String?
  location      String?
  latitude      Float?
  longitude     Float?
  notes         String?

  assignedToId Int?  @map("assigned_to_id")
  assignedTo   User? @relation("AssignedSchools", fields: [assignedToId], references: [id])

  referredBySchoolId Int?     @map("referred_by_school_id")
  referredBySchool   School?  @relation("SchoolReferrals", fields: [referredBySchoolId], references: [id])
  referredSchools    School[] @relation("SchoolReferrals")

  createdFromLeadId Int?  @unique @map("created_from_lead_id")
  createdFromLead   Lead? @relation("ConvertedFromLead", fields: [createdFromLeadId], references: [id])

  totalStudents Int? @map("total_students")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  referredLeads             Lead[]              @relation("ReferredLeads")
  quotations                Quotation[]
  agreements                Agreement[]
  schoolAddons              SchoolAddon[]
  tasks                     Task[]
  timelineEvents            TimelineEvent[]
  contacts                  Contact[]
  referralIncentivesGiven   ReferralIncentive[] @relation("ReferringSchool")
  referralIncentiveReceived ReferralIncentive?  @relation("ConvertedSchool")

  @@index([assignedToId])
  @@index([referredBySchoolId])
  @@index([createdAt])
  @@map("schools")
}

model Quotation {
  order SchoolOrder?
  versions QuotationVersion[]
  approvalStatus String @default("NONE")
  approvedById Int?
  approvedAt DateTime?
  id       Int     @id @default(autoincrement())
  leadId   Int?    @map("lead_id")
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  schoolId Int?    @map("school_id")
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subtotal Decimal
  discount Decimal @default(0)
  tax      Decimal @default(0)
  total    Decimal
  status   String  @default("DRAFT")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items QuotationItem[]

  @@index([leadId])
  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int       @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  type        String
  quantity    Int       @default(1)
  unitPrice   Decimal   @map("unit_price")
  total       Decimal

  @@index([quotationId])
  @@map("quotation_items")
}

model Agreement {
  renewalCase RenewalCase?
  orders SchoolOrder[]
  work SchoolWork[]
  payments AgreementPayment[]
  renewalReminders AgreementRenewalReminder[]
  id          Int      @id @default(autoincrement())
  schoolId    Int      @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  renewalDate DateTime? @map("renewal_date")
  status           String  @default("ACTIVE")
  value            Decimal
  advancePayment   Decimal @default(0) @map("advance_payment")
  totalInstalments Int     @default(0) @map("total_instalments")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([status])
  @@index([endDate])
  @@map("agreements")
}

model Addon {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Decimal
  category    String  @default("ADDON")
  tiers       String? // JSON: [{label,maxStudents,price}]

  createdAt DateTime @default(now()) @map("created_at")

  schoolAddons SchoolAddon[]

  @@map("addons")
}

model SchoolAddon {
  id        Int      @id @default(autoincrement())
  schoolId  Int?     @map("school_id")
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  leadId    Int?     @map("lead_id")
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  addonId   Int      @map("addon_id")
  addon     Addon    @relation(fields: [addonId], references: [id])
  price     Decimal
  startDate DateTime @map("start_date")

  @@index([schoolId])
  @@index([leadId])
  @@index([addonId])
  @@map("school_addons")
}

model ReferralIncentive {
  id                   Int      @id @default(autoincrement())
  referringSchoolId    Int      @map("referring_school_id")
  referringSchool      School   @relation("ReferringSchool", fields: [referringSchoolId], references: [id], onDelete: Cascade)
  leadId               Int      @unique @map("lead_id")
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  convertedSchoolId    Int?     @unique @map("converted_school_id")
  convertedSchool      School?  @relation("ConvertedSchool", fields: [convertedSchoolId], references: [id])
  bonusType            String   @map("bonus_type")
  bonusValue           Decimal  @map("bonus_value")
  calculatedCommission Decimal? @map("calculated_commission")
  payoutStatus         String   @default("PENDING") @map("payout_status")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([referringSchoolId])
  @@index([payoutStatus])
  @@map("referral_incentives")
}

model Task {
  id      Int      @id @default(autoincrement())
  title   String
  type    String
  dueDate DateTime @map("due_date")
  status  String   @default("PENDING")
  notes   String?
  // Set when the task is sent to Expo push — prevents duplicate reminders.
  reminderSentAt DateTime? @map("reminder_sent_at")

  assignedToId Int?    @map("assigned_to")
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])
  leadId       Int?    @map("lead_id")
  lead         Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  schoolId     Int?    @map("school_id")
  school       School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
  @@index([leadId])
  @@index([schoolId])
  @@map("tasks")
}

/// Short-lived store for idempotent POST/PUT/DELETE replays from offline mobile clients.
/// Client sends a UUID `Idempotency-Key` header; we cache the response body + status
/// for 24h so a duplicate request (queue replay after a flaky network) returns the
/// original response instead of creating a second record.
model IdempotencyKey {
  id         Int      @id @default(autoincrement())
  /// Scoped per-user so two users can't collide. We index on (userId, key) for fast lookup.
  userId     Int      @map("user_id")
  key        String
  method     String
  path       String
  status     Int
  response   String   /// JSON-stringified response body
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model TimelineEvent {
  id          Int     @id @default(autoincrement())
  leadId      Int?    @map("lead_id")
  lead        Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  schoolId    Int?    @map("school_id")
  school      School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventType   String  @map("event_type")
  description String
  createdById Int?    @map("created_by")
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Field-level audit diff (JSON-stringified). Shape: { field: { before, after } }
  // Optional: only set for UPDATE events. Keeps the table compact for simple logs.
  diff String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([schoolId])
  @@index([eventType])
  @@index([createdAt])
  @@map("timeline_events")
}

model AgreementPayment {
  review PaymentReview?
  followUps SchoolWork[]
  id Int @id @default(autoincrement())
  agreementId Int @map("agreement_id")
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  amount Decimal
  dueDate DateTime @map("due_date")
  paidAt DateTime? @map("paid_at")
  reference String?
  createdById Int @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([agreementId])
  @@map("agreement_payments")
}

model AgreementRenewalReminder {
  id Int @id @default(autoincrement())
  agreementId Int @map("agreement_id")
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  renewalDate DateTime @map("renewal_date")
  daysBefore Int @map("days_before")
  taskId Int @unique @map("task_id")
  @@unique([agreementId, renewalDate, daysBefore])
  @@map("agreement_renewal_reminders")
}

model SchoolWork {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind String
  status String
  title String
  notes String?
  outcome String?
  dueAt DateTime?
  checkedInAt DateTime?
  latitude Float?
  longitude Float?
  assignedToId Int?
  assignedTo User? @relation(fields: [assignedToId], references: [id])
  agreementId Int?
  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  templateKey String?
  paymentId Int?
  payment AgreementPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  followUpTaskId Int?
  createdById Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files SchoolFile[]
  events SchoolWorkEvent[]
  messages SupportMessage[]
  supportCategory String?
  portalContactId Int?
  portalRequestId String?
  @@unique([portalContactId, portalRequestId])
  @@unique([agreementId, templateKey])
  @@index([kind, schoolId])
  @@index([assignedToId])
  @@index([paymentId])
  @@map("school_work")
}

model SupportMessage {
  id Int @id @default(autoincrement())
  workId Int
  work SchoolWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  senderType String
  senderId Int
  senderName String
  requestId String
  text String
  createdAt DateTime @default(now())
  portalReads PortalReplyRead[]
  @@unique([workId, senderType, senderId, requestId])
  @@index([workId, id])
  @@index([senderType, id])
  @@map("support_messages")
}

model SchoolFile {
  portalDocument PortalDocument?
  paymentProofs PaymentReview[]
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  workId Int?
  work SchoolWork? @relation(fields: [workId], references: [id], onDelete: Cascade)
  name String
  category String
  mimeType String
  size Int
  content Bytes
  uploadedById Int
  createdAt DateTime @default(now())
  @@index([schoolId])
  @@index([workId])
  @@map("school_files")
}

model QuotationVersion {
  portalQuote PortalQuote?
  id Int @id @default(autoincrement())
  quotationId Int
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  number Int
  event String
  snapshot String
  createdById Int
  createdAt DateTime @default(now())
  @@unique([quotationId, number])
  @@map("quotation_versions")
}

model SchoolWorkEvent {
  id Int @id @default(autoincrement())
  workId Int
  work SchoolWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  status String
  notes String?
  createdById Int
  createdAt DateTime @default(now())
  @@index([workId, createdAt])
  @@map("school_work_events")
}

model RenewalCase {
  agreementId Int @id
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  ownerId Int?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  stage String @default("UPCOMING")
  risk String @default("NORMAL")
  proposedValue Decimal?
  notes String?
  nextActionAt DateTime?
  nextTaskId Int?
  closedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([ownerId, nextActionAt])
  @@map("renewal_cases")
}

model SchoolPortalAccess {
  schoolId Int
  id Int @id @default(autoincrement())
  contactId Int @unique
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  devices PortalPushDevice[]
  readReplies PortalReplyRead[]
  @@map("school_portal_access")
}

model PortalPushDevice {
  token String @id
  accessId Int
  access SchoolPortalAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  @@index([accessId])
  @@map("portal_push_devices")
}

model PortalReplyRead {
  accessId Int
  access SchoolPortalAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  messageId Int
  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@id([accessId, messageId])
  @@index([messageId])
  @@map("portal_reply_reads")
}

model PortalQuote {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  versionId Int @unique
  version QuotationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  response String @default("PENDING")
  responseNote String?
  respondedBy String?
  respondedAt DateTime?
  published Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([schoolId, published])
  @@map("portal_quotes")
}

model PortalDocument {
  fileId Int @id
  file SchoolFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedBySchool Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([schoolId])
  @@map("portal_documents")
}

model SchoolOrder {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  quotationId Int @unique
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  versionNumber Int?
  agreementId Int?
  agreement Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  items SchoolOrderItem[]
  createdAt DateTime @default(now())
  @@index([schoolId])
  @@map("school_orders")
}

model SchoolOrderItem {
  id Int @id @default(autoincrement())
  orderId Int
  order SchoolOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name String
  quantity Int
  seats Int?
  activationDate DateTime?
  activatedAt DateTime?
  status String @default("PENDING")
  blocker String?
  updatedAt DateTime @updatedAt
  @@index([orderId])
  @@map("school_order_items")
}

model BankEntry {
  id Int @id @default(autoincrement())
  reference String @unique
  amount Decimal
  receivedAt DateTime
  review PaymentReview?
  createdAt DateTime @default(now())
  @@map("bank_entries")
}

model PaymentReview {
  paymentId Int @id
  payment AgreementPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reference String?
  proofFileId Int?
  proofFile SchoolFile? @relation(fields: [proofFileId], references: [id], onDelete: SetNull)
  bankEntryId Int? @unique
  bankEntry BankEntry? @relation(fields: [bankEntryId], references: [id], onDelete: Restrict)
  matchedById Int?
  matchedAt DateTime?
  receiptNumber String? @unique
  receiptIssuedAt DateTime?
  updatedAt DateTime @updatedAt
  @@map("payment_reviews")
}

model SalesTerritory {
  id Int @id @default(autoincrement())
  name String @unique
  schools TerritorySchool[]
  targets SalesTarget[]
  @@map("sales_territories")
}

model TerritorySchool {
  schoolId Int @id
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  territoryId Int
  territory SalesTerritory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  @@index([territoryId])
  @@map("territory_schools")
}

model SalesTarget {
  id Int @id @default(autoincrement())
  period String
  subject String
  salespersonId Int?
  salesperson User? @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  territoryId Int?
  territory SalesTerritory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  visits Int
  conversions Int
  collections Decimal
  renewals Int
  @@unique([period, subject])
  @@map("sales_targets")
}

model InboxRead {
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String
  readAt DateTime @default(now())
  @@id([userId, key])
  @@map("inbox_reads")
}
